{
  "manifest_version": 3,
  "name": "Website Redirector",
  "version": "1.0.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "ec00d5a7-84dc-4539-80c0-7fb4cf9d37c4",
      "update_url": "https://raw.githubusercontent.com/Steffengra/website-redirector/refs/heads/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
